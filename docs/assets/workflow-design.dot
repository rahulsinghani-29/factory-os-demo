digraph workflow {
rankdir=TB; center=true; splines=ortho; bgcolor="white"; nodesep=0.65; ranksep=0.65; pad=0.25;
node [shape=box,style="rounded,filled",fontname="Helvetica",fontsize=13,fontcolor="#142231",color="#607080",margin="0.16,0.12"];
edge [fontname="Helvetica",fontsize=11,color="#607080",fontcolor="#263342",arrowsize=0.7];
"__start__" [label="START · One incoming message",shape=oval,style="rounded,filled",fillcolor="#f3f4f6"];
"receive_message" [label="CODE\nAccept one incoming WhatsApp-style message",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"route_input" [label="IF / ELSE\nPhoto, text, or unsupported audio/video?",shape=diamond,style="rounded,filled",fillcolor="#fff3ce"];
"ocr_photo" [label="LLM CALL\nTranscribe photo with Gemma 3 4B via Ollama",shape=box,style="rounded,filled",fillcolor="#f0eaff"];
"preserve_text" [label="CODE\nPreserve the original text",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"parse_document" [label="CODE\nRead PO, line and hourly rows from text",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"get_po_details" [label="TOOL CALL\nGet PO due date and required quantity\nLocal fixture API adapter",shape=box,style="rounded,filled",fillcolor="#e7f1ff"];
"get_handoff_status" [label="TOOL CALL\nGet cutting, finishing and QC status\nLocal fixture API adapter",shape=box,style="rounded,filled",fillcolor="#e7f1ff"];
"get_production_plan" [label="TOOL CALL\nGet working calendar and prior sewn total\nLocal fixture API adapter",shape=box,style="rounded,filled",fillcolor="#e7f1ff"];
"get_prior_messages" [label="TOOL CALL\nGet preceding WhatsApp updates\nLocal fixture adapter",shape=box,style="rounded,filled",fillcolor="#e7f1ff"];
"calculate_pace_scenarios" [label="CODE\nCalculate pace within planned work hours",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"qwen_inference" [label="LLM CALL\nCompare the message with records using Qwen",shape=box,style="rounded,filled",fillcolor="#f0eaff"];
"validate_evidence" [label="CODE\nCheck quotes, references and uncertainty",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"route_result" [label="IF / ELSE\nIs the checked result clear or unclear?",shape=diamond,style="rounded,filled",fillcolor="#fff3ce"];
"clear_result" [label="CODE\nPrepare clear result\nPass the checked sewing-risk answer to the report",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"supervisor_hold" [label="CODE\nPrepare clarification request\nPass missing facts to the report; no task is sent",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"unsupported_media" [label="CODE\nHold unsupported audio/video input",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"run_failed" [label="CODE\nKeep the failure as an unclear result",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"prepare_report" [label="CODE\nPrepare the report\nPython templates; no LLM call",shape=box,style="rounded,filled",fillcolor="#edf7f1"];
"__end__" [label="END",shape=oval,style="rounded,filled",fillcolor="#f3f4f6"];
"understand_message" [label="PROPOSED · LLM CALL\nIdentify the message purpose and explicit PO",shape=box,style="rounded,filled,dashed",fillcolor="#f0eaff"];
"relevant_message" [label="PROPOSED · IF / ELSE\nIs this a relevant factory update?",shape=diamond,style="rounded,filled,dashed",fillcolor="#fff3ce"];
"explicit_po" [label="PROPOSED · IF / ELSE\nDoes the message identify one PO?",shape=diamond,style="rounded,filled,dashed",fillcolor="#fff3ce"];
"recent_three" [label="PROPOSED · TOOL CALL\nRead the previous three messages\nSame factory and conversation, before this message",shape=box,style="rounded,filled,dashed",fillcolor="#e7f1ff"];
"context_po" [label="PROPOSED · IF / ELSE\nExactly one PO in those messages\nand a clear continuation of that discussion?",shape=diamond,style="rounded,filled,dashed",fillcolor="#fff3ce"];
"inherit_po" [label="PROPOSED · CODE\nUse that PO and record its source\nNever replace an explicit or conflicting PO",shape=box,style="rounded,filled,dashed",fillcolor="#edf7f1"];
"ignore_message" [label="END · Ignore this message\nNo response and no PO report",shape=oval,style="rounded,filled,dashed",fillcolor="#f3f4f6"];
"__start__" -> "receive_message" [xlabel="",weight=10];
"calculate_pace_scenarios" -> "qwen_inference" [xlabel="ok",weight=10];
"clear_result" -> "prepare_report" [xlabel="",weight=10];
"get_handoff_status" -> "get_production_plan" [xlabel="ok",weight=10];
"get_po_details" -> "get_handoff_status" [xlabel="ok",weight=10];
"get_prior_messages" -> "calculate_pace_scenarios" [xlabel="ok",weight=10];
"get_production_plan" -> "get_prior_messages" [xlabel="ok",weight=10];
"ocr_photo" -> "parse_document" [xlabel="ok",weight=10];
"preserve_text" -> "parse_document" [xlabel="ok",weight=10];
"qwen_inference" -> "validate_evidence" [xlabel="ok",weight=10];
"receive_message" -> "route_input" [xlabel="ok",weight=10];
"route_input" -> "ocr_photo" [xlabel="photo",weight=10];
"route_input" -> "preserve_text" [xlabel="text",weight=10];
"route_input" -> "unsupported_media" [xlabel="unsupported",weight=10];
"route_result" -> "clear_result" [xlabel="clear",weight=10];
"route_result" -> "supervisor_hold" [xlabel="unclear",weight=10];
"run_failed" -> "prepare_report" [xlabel="",weight=10];
"supervisor_hold" -> "prepare_report" [xlabel="",weight=10];
"unsupported_media" -> "prepare_report" [xlabel="",weight=10];
"validate_evidence" -> "route_result" [xlabel="ok",weight=10];
"prepare_report" -> "__end__" [xlabel="",weight=10];
"parse_document" -> "understand_message" [xlabel="",weight=10];
"understand_message" -> "relevant_message" [xlabel="",weight=10];
"understand_message" -> "run_failed" [xlabel="Classifier failure",weight=10];
"relevant_message" -> "ignore_message" [xlabel="No",weight=10];
"relevant_message" -> "explicit_po" [xlabel="Yes",weight=10];
"explicit_po" -> "get_po_details" [xlabel="Yes",weight=10];
"explicit_po" -> "recent_three" [xlabel="Missing",weight=10];
"explicit_po" -> "ignore_message" [xlabel="Multiple / conflicting POs",weight=10];
"recent_three" -> "context_po" [xlabel="",weight=10];
"context_po" -> "inherit_po" [xlabel="Yes",weight=10];
"context_po" -> "ignore_message" [xlabel="No / uncertain",weight=10];
"inherit_po" -> "get_po_details" [xlabel="",weight=10];
"ocr_photo" -> "run_failed" [xlabel="Read failure",weight=10];
"qwen_inference" -> "run_failed" [xlabel="Model failure",weight=10];
"validate_evidence" -> "run_failed" [xlabel="Check failure",weight=10];
}
